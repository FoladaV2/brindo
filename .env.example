# Copy to .env.local (never committed) and fill in. This file is committed: never put real keys here.
# Use a development project, never production: `npm run test:db` creates and deletes users in
# whatever project this points at.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard → Project Settings → API (or `supabase status` for a local stack)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import src/lib/supabase/service.ts from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the Supabase CLI to push migrations (`supabase db push --db-url ...`).
# Dashboard → Connect → Session pooler connection string, with your database password filled in.
SUPABASE_DB_URL=

# Payments (server only; see docs/payments.md). Test-mode values everywhere except production.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dodo dashboard → Developer → API Keys (same mode)
DODO_PAYMENTS_API_KEY=
# Dodo dashboard → Developer → Webhooks → your endpoint's signing secret (whsec_…, same mode)
DODO_PAYMENTS_WEBHOOK_KEY=
# The Brindo product in the same mode (live: pdt_0NqiU8Cm0ztUAQvaPb1s)
DODO_PRODUCT_ID=
# Optional: ignore payments for the business's other brands
DODO_BRAND_ID=brnd_0NqiT3o18NCeoN8cRdC5v
# The price in tetri. Must equal the Dodo product's price.
PRICE_AMOUNT_MINOR=4900
PRICE_CURRENCY=GEL

# Admin: accounts allowed to open /admin (comma-separated emails)
ADMIN_EMAILS=
# A long random string; makes the anonymous daily visitor hash impossible to match to an IP
ANALYTICS_SECRET=
